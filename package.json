	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "tsc && biome check && wp-scripts build",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"test:e2e": "node scripts/run-e2e.mjs",
		"test:e2e:ui": "npx playwright test --ui",
		"start": "wp-scripts start"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@playwright/test": "^1.62.1",
		"@types/node": "^20.17.10",
		"@types/wordpress__block-editor": "^15.0.6",
		"@wordpress/e2e-test-utils-playwright": "^1.52.0",
		"@wordpress/scripts": "^34.0.0",
		"@wp-playground/cli": "^3.1.48",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@wordpress/block-editor": "^16.1.0",
		"@wordpress/blocks": "^15.25.0",
		"@wordpress/components": "^38.0.0",
		"@wordpress/data": "^10.52.0",
		"@wordpress/element": "^8.4.0",
		"@wordpress/i18n": "^6.25.0",
		"postcss": "^8.5.25",
		"tailwindcss": "^4.3.3"
	}
