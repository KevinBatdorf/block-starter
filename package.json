{
	"name": "block-starter",
	"version": "0.1.0",
	"type": "module",
	"description": "A text block where each line is full width.",
	"author": "Kevin Batdorf",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "tsc && biome check && wp-scripts build",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"test:e2e": "node scripts/run-e2e.mjs",
		"test:e2e:ui": "npx playwright test --ui",
		"start": "wp-scripts start"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.11",
		"@playwright/test": "^1.59.1",
		"@types/node": "^20.17.10",
		"@types/wordpress__block-editor": "^15.0.5",
		"@types/wordpress__blocks": "^15.10.2",
		"@wordpress/e2e-test-utils-playwright": "^1.43.0",
		"@wordpress/scripts": "^31.8.0",
		"@wp-playground/cli": "^3.1.18",
		"typescript": "^6.0.2"
	},
	"dependencies": {
		"@tailwindcss/postcss": "^4.2.2",
		"@wordpress/block-editor": "^15.16.0",
		"@wordpress/blocks": "^15.16.0",
		"@wordpress/components": "^32.5.0",
		"@wordpress/data": "^10.43.0",
		"@wordpress/element": "^6.43.0",
		"@wordpress/i18n": "^6.16.0",
		"postcss": "^8.5.9",
		"tailwindcss": "^4.2.2"
	}
